{
  "name": "@bilhanah/dashboard",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "npm@11.16.0",
  "engines": {
    "node": ">=24"
  },
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "postinstall": "npm run build -w @bilhanah/contracts",
    "dev": "vite --host 127.0.0.1",
    "dev:admin": "VITE_APP=admin vite --host 127.0.0.1 --port 5175",
    "build": "tsc --noEmit && vite build",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.node.json",
    "preview": "vite preview --host 127.0.0.1",
    "test": "vitest run",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "@bilhanah/contracts": "0.1.0",
    "@dnd-kit/core": "6.3.1",
    "@dnd-kit/sortable": "10.0.0",
    "@dnd-kit/utilities": "3.2.2",
    "@fontsource-variable/manrope": "5.3.0",
    "@fontsource-variable/noto-sans-arabic": "5.3.0",
    "@hookform/resolvers": "5.9.1",
    "@phosphor-icons/react": "2.1.10",
    "@tanstack/react-query": "5.104.1",
    "i18next": "26.7.1",
    "qrcode.react": "4.2.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-hook-form": "7.89.0",
    "react-i18next": "17.1.11",
    "react-router": "8.4.0",
    "socket.io-client": "4.8.4",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@playwright/test": "1.64.1",
    "@types/node": "24.19.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "typescript": "7.0.2",
    "vite": "8.3.4",
    "vitest": "4.1.12"
  }
}
